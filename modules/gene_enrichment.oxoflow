[rules.environment]
conda = "envs/gene_enrichment_analysis.yaml"

[[rules]]
name = "gene_preranked_GSEApy_Azimuth_2023"
description = "Preranked gene set enrichment analysis (GSEA) with GSEApy (Azimuth_2023 database)"
