shell = "Rscript scripts/enrichment_plot.R {input[0]} {output[0]} GREAT Reactome {region_set} scripts/utils.R {config.cn_GREAT_top_n} {config.cn_GREAT_p_value} {config.cn_GREAT_adj_pvalue} {config.cn_GREAT_effect_size} {config.cn_GREAT_overlap} {config.cn_GREAT_term}"
log = "logs/rules/plot_enrichment_result_GREAT_{region_set}_Reactome.log"
tags = ["plots", "GREAT"]

[rules.scatter]
variable = "region_set"
values_from = "config.region_sets"

[rules.environment]
conda = "envs/visualization.yaml"

[[rules]]
name = "plot_enrichment_result_pycisTarget_hg38_screen_v10clust"
description = "Enrichment plot of pycisTarget results (hg38_screen_v10clust)"
input = ["{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/{region_set}_hg38_screen_v10clust.csv"]
