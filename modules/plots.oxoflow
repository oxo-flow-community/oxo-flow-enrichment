# Enrichment plots (upstream rule plot_enrichment_result).
# One rule block per (tool, db); fan-out over feature sets (region sets for
# region-based tools, ranked gene sets for preranked_GSEApy). Upstream also
# plots RcisTarget results — zero gene-set instances on the default
# annotation, so RcisTarget is not ported (see README fidelity table).

[workflow]
name = "oxo-flow-enrichment-plots"
version = "3.0.1"
description = "Per-feature-set enrichment plots fragment"

[[rules]]
name = "plot_enrichment_result_LOLA_LOLACore"
description = "Enrichment plot of LOLA results (LOLACore)"
input = ["{config.result_path}/{region_set}/LOLA/LOLACore/{region_set}_LOLACore.csv"]
output = ["{config.result_path}/{region_set}/LOLA/LOLACore/{region_set}_LOLACore.png"]
shell = "Rscript scripts/enrichment_plot.R {input[0]} {output[0]} LOLA LOLACore {region_set} scripts/utils.R {config.cn_LOLA_top_n} {config.cn_LOLA_p_value} {config.cn_LOLA_adj_pvalue} {config.cn_LOLA_effect_size} {config.cn_LOLA_overlap} {config.cn_LOLA_term}"
log = "logs/rules/plot_enrichment_result_LOLA_{region_set}_LOLACore.log"
tags = ["plots", "LOLA"]

[rules.scatter]
variable = "region_set"
values_from = "config.region_sets"

[rules.environment]
conda = "envs/visualization.yaml"

[[rules]]
name = "plot_enrichment_result_GREAT_Azimuth_2023"
description = "Enrichment plot of GREAT results (Azimuth_2023)"
input = ["{config.result_path}/{region_set}/GREAT/Azimuth_2023/{region_set}_Azimuth_2023.csv"]
output = ["{config.result_path}/{region_set}/GREAT/Azimuth_2023/{region_set}_Azimuth_2023.png"]
shell = "Rscript scripts/enrichment_plot.R {input[0]} {output[0]} GREAT Azimuth_2023 {region_set} scripts/utils.R {config.cn_GREAT_top_n} {config.cn_GREAT_p_value} {config.cn_GREAT_adj_pvalue} {config.cn_GREAT_effect_size} {config.cn_GREAT_overlap} {config.cn_GREAT_term}"
log = "logs/rules/plot_enrichment_result_GREAT_{region_set}_Azimuth_2023.log"
tags = ["plots", "GREAT"]

[rules.scatter]
variable = "region_set"
values_from = "config.region_sets"

[rules.environment]
conda = "envs/visualization.yaml"

[[rules]]
name = "plot_enrichment_result_GREAT_Reactome"
description = "Enrichment plot of GREAT results (Reactome)"
input = ["{config.result_path}/{region_set}/GREAT/Reactome/{region_set}_Reactome.csv"]
