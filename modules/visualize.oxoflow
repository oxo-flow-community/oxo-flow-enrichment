# Summary plots per group (upstream rule visualize).
# One rule block per (group, tool, db) combination present on the default
# path (mirrors modules/aggregate.oxoflow); each produces the topTerms and
# specificTerms summary plots.

[workflow]
name = "oxo-flow-enrichment-visualize"
version = "3.0.1"
description = "Per-group summary plots fragment"

[[rules]]
name = "visualize_ORA_GSEApy_Azimuth_2023_ATAC"
description = "Summary plots of aggregated ORA_GSEApy results (ATAC group, Azimuth_2023)"
input = ["{config.result_path}/ATAC/ORA_GSEApy/Azimuth_2023/ATAC_Azimuth_2023_all.csv"]
output = [
    "{config.result_path}/ATAC/ORA_GSEApy/Azimuth_2023/ATAC_Azimuth_2023_summary_topTerms.png",
    "{config.result_path}/ATAC/ORA_GSEApy/Azimuth_2023/ATAC_Azimuth_2023_summary_specificTerms.png",
]
shell = "Rscript scripts/overview_plot.R {input[0]} {output[0]} {output[1]} ORA_GSEApy Azimuth_2023 ATAC scripts/utils.R {config.cn_ORA_GSEApy_term} {config.cn_ORA_GSEApy_adj_pvalue} {config.cn_ORA_GSEApy_effect_size} {config.top_terms_n} {config.adjp_cap} {config.or_cap} {config.adjp_th_ORA_GSEApy} {config.cluster_summary}"
log = "logs/rules/visualize_ORA_GSEApy_Azimuth_2023_ATAC.log"
tags = ["visualize", "GSEApy", "ORA"]

[rules.environment]
conda = "envs/visualization.yaml"

[[rules]]
name = "visualize_ORA_GSEApy_Reactome_ATAC"
description = "Summary plots of aggregated ORA_GSEApy results (ATAC group, Reactome)"
input = ["{config.result_path}/ATAC/ORA_GSEApy/Reactome/ATAC_Reactome_all.csv"]
