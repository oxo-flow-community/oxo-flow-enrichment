log = "logs/rules/aggregate_RcisTarget_hg38_500bp_up_100bp_down_v10clust_ATAC.log"
tags = ["aggregate", "RcisTarget"]

[rules.environment]
conda = "envs/gene_enrichment_analysis.yaml"
