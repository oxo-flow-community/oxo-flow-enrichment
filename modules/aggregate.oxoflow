[[rules]]
name = "aggregate_pycisTarget_hg38_screen_v10clust_ATAC"
description = "Aggregate pycisTarget results of the ATAC group (hg38_screen_v10clust)"
when = 'config.pycistarget_db_hg38_screen_v10clust != "" && config.path_to_motif_annotations != ""'
input = []
expand_inputs = [
    { pattern = "{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/{region_set}_hg38_screen_v10clust.csv", variables = { region_set = "config.region_sets" } }
]
output = ["{config.result_path}/ATAC/pycisTarget/hg38_screen_v10clust/ATAC_hg38_screen_v10clust_all.csv"]
shell = "python scripts/aggregate.py {input} --out {output[0]} --group ATAC --tool pycisTarget --db hg38_screen_v10clust"
log = "logs/rules/aggregate_pycisTarget_hg38_screen_v10clust_ATAC.log"
tags = ["aggregate", "pycisTarget"]

[rules.environment]
conda = "envs/gene_enrichment_analysis.yaml"

[[rules]]
name = "aggregate_RcisTarget_hg38_500bp_up_100bp_down_v10clust_ATAC"
description = "Aggregate RcisTarget results of the ATAC group (hg38_500bp_up_100bp_down_v10clust)"
when = 'config.rcistarget_db_hg38_500bp_up_100bp_down_v10clust != "" && config.rcistarget_motif_annot != ""'
