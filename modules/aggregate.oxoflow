[[rules]]
name = "aggregate_LOLA_LOLACore_ATAC"
description = "Aggregate LOLA results of the ATAC group (LOLACore)"
input = []
expand_inputs = [
    { pattern = "{config.result_path}/{region_set}/LOLA/LOLACore/{region_set}_LOLACore.csv", variables = { region_set = "config.region_sets" } }
