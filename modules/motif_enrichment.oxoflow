# Motif enrichment analyses: region TFBS motifs with pycisTarget (upstream
# rules: region_motif_enrichment_analysis_pycisTarget,
# process_results_pycisTarget) and gene TFBS motifs with RcisTarget
# (upstream rule: gene_motif_enrichment_analysis_RcisTarget).
# The pycisTarget command text is the upstream shell verbatim (incl. the
# upstream error-tolerance wrapper that touches empty outputs and exits 0).
# Both branches are when-gated on user-provided databases, matching
# upstream's "to skip you have to leave one database entry with an empty
# path" convention. Upstream fans RcisTarget over region sets (via the GREAT
# genes.txt mapping) and over .txt gene sets (annotation rows ending in
# .txt); the port does the same: the region-set block fans over
# config.region_sets, the txt block fans over config.txt_gene_sets (zero
# instances when the default-empty list is unset, so the default plan is
# unchanged).

[workflow]
name = "oxo-flow-enrichment-motif-enrichment"
version = "3.0.1"
description = "Motif enrichment fragment (pycisTarget, RcisTarget)"

[[rules]]
name = "region_motif_enrichment_analysis_pycisTarget"
description = "Region TFBS motif enrichment analysis with pycisTarget"
input = [
    "{config.region_beds}/{region_set}.bed",
    "{config.pycistarget_db_hg38_screen_v10clust}",
    "{config.path_to_motif_annotations}",
]
output = [
    "{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/motif_enrichment_cistarget_{region_set}.hdf5",
    "{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/motif_enrichment_cistarget_{region_set}.html",
]
when = 'config.pycistarget_db_hg38_screen_v10clust != "" && config.path_to_motif_annotations != ""'
shell = """
{
    pycistarget cistarget \
        --cistarget_db_fname {input[1]} \
        --bed_fname {input[0]} \
        --output_folder $(dirname {output[0]}) \
        --fr_overlap_w_ctx_db {config.pycistarget_fraction_overlap_w_cistarget_database} \
        --auc_threshold {config.pycistarget_auc_threshold} \
        --nes_threshold {config.pycistarget_nes_threshold} \
        --rank_threshold {config.pycistarget_rank_threshold} \
        --path_to_motif_annotations {input[2]} \
        --annotation_version {config.pycistarget_annotation_version} \
        --annotations_to_use {config.pycistarget_annotations_to_use} \
        --motif_similarity_fdr {config.pycistarget_motif_similarity_fdr} \
        --orthologous_identity_threshold {config.pycistarget_orthologous_identity_threshold} \
        --species {config.species} \
        --name {region_set} \
        --output_mode 'hdf5' \
        --write_html
} || {
    echo "An error occurred during the region TFBS motif enrichment analysis using pycisTarget"; touch {output[0]} {output[1]}; exit 0;
}
"""
log = "logs/rules/region_enrichment_analysis_pycisTarget_{region_set}_hg38_screen_v10clust.log"
tags = ["pycisTarget", "motif-enrichment"]

[rules.scatter]
variable = "region_set"
values_from = "config.region_sets"

[rules.resources]
threads = 10
memory = "32000M"   # upstream resources mem_mb=config["mem"] (32000)

[rules.environment]
conda = "envs/pycisTarget.yaml"

[[rules]]
name = "process_results_pycisTarget"
description = "Postprocess pycisTarget hdf5 results to CSV tables"
when = 'config.pycistarget_db_hg38_screen_v10clust != "" && config.path_to_motif_annotations != ""'
input = ["{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/motif_enrichment_cistarget_{region_set}.hdf5"]
output = [
    "{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/{region_set}_hg38_screen_v10clust.csv",
    "{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/{region_set}_hg38_screen_v10clust.motif_hits.csv",
    "{config.result_path}/{region_set}/pycisTarget/hg38_screen_v10clust/{region_set}_hg38_screen_v10clust.cistromes.csv",
]
shell = "python scripts/process_results_pycisTarget.py {input[0]} {output[0]} {output[1]} {output[2]} {region_set} {config.pycistarget_term_col}"
log = "logs/rules/process_results_pycisTarget_{region_set}_hg38_screen_v10clust.log"
tags = ["pycisTarget", "motif-enrichment"]

[rules.scatter]
variable = "region_set"
values_from = "config.region_sets"

[rules.environment]
conda = "envs/pycisTarget.yaml"

[[rules]]
name = "gene_motif_enrichment_analysis_RcisTarget"
description = "Gene TFBS motif enrichment analysis with RcisTarget (hg38_500bp_up_100bp_down_v10clust database)"
when = 'config.rcistarget_db_hg38_500bp_up_100bp_down_v10clust != "" && config.rcistarget_motif_annot != ""'
input = [
    "{config.result_path}/{region_set}/GREAT/genes.txt",
    "{config.result_path}/{config.background_name}/GREAT/genes.txt",
    "{config.rcistarget_db_hg38_500bp_up_100bp_down_v10clust}",
    "{config.rcistarget_motif_annot}",
]
output = ["{config.result_path}/{region_set}/RcisTarget/hg38_500bp_up_100bp_down_v10clust/{region_set}_hg38_500bp_up_100bp_down_v10clust.csv"]
shell = "Rscript scripts/gene_enrichment_analysis_RcisTarget.R {input[0]} {input[1]} {input[2]} {input[3]} {output[0]} {region_set} {config.rcistarget_motifAnnot_highConfCat} {config.rcistarget_motifAnnot_lowConfCat} {config.rcistarget_nesThreshold} {config.rcistarget_aucMaxRank_factor} {config.rcistarget_geneErnMethod} {config.rcistarget_geneErnMaxRank} {threads}"
log = "logs/rules/gene_motif_enrichment_analysis_RcisTarget_{region_set}_hg38_500bp_up_100bp_down_v10clust.log"
tags = ["RcisTarget", "motif-enrichment"]

[rules.scatter]
variable = "region_set"
values_from = "config.region_sets"

[rules.environment]
conda = "envs/RcisTarget.yaml"

[[rules]]
name = "gene_motif_enrichment_analysis_RcisTarget_txt"
description = "Gene TFBS motif enrichment analysis with RcisTarget over .txt gene sets (hg38_500bp_up_100bp_down_v10clust database)"
when = 'config.rcistarget_db_hg38_500bp_up_100bp_down_v10clust != "" && config.rcistarget_motif_annot != ""'
input = [
    "{config.txt_gene_set_dir}/{gene_set}.txt",
    "{config.txt_gene_set_dir}/{config.txt_gene_set_background}.txt",
    "{config.rcistarget_db_hg38_500bp_up_100bp_down_v10clust}",
    "{config.rcistarget_motif_annot}",
]
output = ["{config.result_path}/{gene_set}/RcisTarget/hg38_500bp_up_100bp_down_v10clust/{gene_set}_hg38_500bp_up_100bp_down_v10clust.csv"]
shell = "Rscript scripts/gene_enrichment_analysis_RcisTarget.R {input[0]} {input[1]} {input[2]} {input[3]} {output[0]} {gene_set} {config.rcistarget_motifAnnot_highConfCat} {config.rcistarget_motifAnnot_lowConfCat} {config.rcistarget_nesThreshold} {config.rcistarget_aucMaxRank_factor} {config.rcistarget_geneErnMethod} {config.rcistarget_geneErnMaxRank} {threads}"
log = "logs/rules/gene_motif_enrichment_analysis_RcisTarget_{gene_set}_hg38_500bp_up_100bp_down_v10clust.log"
tags = ["RcisTarget", "motif-enrichment"]

[rules.scatter]
variable = "gene_set"
values_from = "config.txt_gene_sets"

[rules.environment]
conda = "envs/RcisTarget.yaml"
